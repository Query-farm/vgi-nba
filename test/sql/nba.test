# name: test/sql/nba.test
# description: Hermetic end-to-end coverage: every current table in all three league schemas,
#   served from the recorded fixtures by test/mock_api/server.py (see ci/run-integration.sh).
# group: [nba]

require vgi

require-env VGI_NBA_WORKER

require-env NBA_STATS_BASE_URL

statement ok
ATTACH 'nba' (TYPE vgi, LOCATION '{VGI_NBA_WORKER}');

# Every current table returns rows.

query I
SELECT count(*) > 0 FROM nba.nba.current_standings;
----
true

query I
SELECT count(*) > 0 FROM nba.nba.current_scoreboard;
----
true

query I
SELECT count(*) > 0 FROM nba.nba.current_schedule;
----
true

query I
SELECT count(*) > 0 FROM nba.nba.current_teams;
----
true

query I
SELECT count(*) > 0 FROM nba.nba.current_players;
----
true

query I
SELECT count(*) > 0 FROM nba.nba.current_player_stats;
----
true

query I
SELECT count(*) > 0 FROM nba.nba.current_team_stats;
----
true

query I
SELECT count(*) > 0 FROM nba.nba.franchise_history;
----
true

