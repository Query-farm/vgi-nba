# The trimmed fixtures keep 73 player points and 7 play-by-play actions.
query I
SELECT sum(points) FROM nba.nba.box_score('0022600201');
----
73

query I
SELECT count(*) FROM nba.nba.play_by_play('0022600201');
----
7
